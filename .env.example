# Configuração do Firebase (Console > Configurações do projeto > Seus apps).
# Copie para `.env.local` e preencha. Vite só expõe variáveis com prefixo VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" conecta Auth/Firestore aos emuladores locais em vez da nuvem.
VITE_USE_FIREBASE_EMULATOR=false

# Onde o NAVEGADOR procura os emuladores. Só vale com a flag acima ligada.
# Deixe em branco para 127.0.0.1:8080 (Firestore) e 127.0.0.1:9099 (Auth).
# Mude quando o navegador não estiver na mesma máquina dos emuladores — por
# exemplo, num túnel SSH em que a porta local difere da do firebase.json.
VITE_FIREBASE_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_PORT=
VITE_AUTH_EMULATOR_PORT=
